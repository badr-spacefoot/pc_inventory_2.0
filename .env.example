# Frontend public configuration
# A definir dans frontend/config.js ou en remplaçant les valeurs dans frontend/app.js lors du deploiement.
IT_INVENTORY_API_URL=https://oletfrcaptvardmdwacy.supabase.co/functions/v1/inventory-api
IT_INVENTORY_SCRIPT_URL=https://badr-spacefoot.github.io/pc_inventory_2.0/scripts/collect-windows.ps1
IT_INVENTORY_STALE_DAYS=30
IT_INVENTORY_WEATHER_LATITUDE=48.8932
IT_INVENTORY_WEATHER_LONGITUDE=2.2879
IT_INVENTORY_WEATHER_LOCATION=Levallois-Perret

# Supabase Edge Function secrets
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_SESSION_SECRET=replace-with-random-32-byte-secret
COLLECTION_ACCESS_TOKEN=replace-with-user-collection-access-token
ALLOWED_ORIGINS=https://YOUR_GITHUB_USER.github.io,http://localhost:8080
# Optional. Leave empty to accept any valid email domain, including .com.
ALLOWED_EMAIL_DOMAINS=

# Optional enrichment providers
# Preferred for eBay Browse API: the Edge Function generates and refreshes the app token server-side.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_MARKETPLACE_ID=EBAY_FR
# Optional fallback for manual tests. Prefer EBAY_CLIENT_ID + EBAY_CLIENT_SECRET in production.
EBAY_BROWSE_API_TOKEN=
GOOGLE_MAPS_API_KEY=
CPU_BENCHMARK_SOURCE_URLS=https://www.cpubenchmark.net/cpu-list/,https://raw.githubusercontent.com/badr-spacefoot/pc_inventory_2.0/main/data/cpu_benchmarks.csv
CPU_BENCHMARK_SYNC_TOKEN=replace-with-random-sync-token
# Protects the weekly authoritative Intel/AMD/Apple/Qualcomm release-date sync.
CPU_RELEASE_SYNC_TOKEN=replace-with-a-different-random-sync-token
ENRICHMENT_CACHE_DAYS=90
