# Copy to inventory-api.env in the isolated stack; chmod 600. Never commit actual values.
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
ALLOW_LEGACY_ADMIN_LOGIN=false
COLLECTION_ACCESS_TOKEN=REPLACE_WITH_COLLECTION_SECRET
ALLOWED_ORIGINS=https://parc.piqa.fr
SUPABASE_PUBLIC_URL=https://parc-api.piqa.fr
ALLOWED_EMAIL_DOMAINS=
CPU_BENCHMARK_SOURCE_URLS=https://www.cpubenchmark.net/cpu-list/,https://raw.githubusercontent.com/badr-spacefoot/pc_inventory_2.0/main/data/cpu_benchmarks.csv
CPU_BENCHMARK_SYNC_TOKEN=REPLACE_WITH_RANDOM_SECRET
CPU_RELEASE_SYNC_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
ENRICHMENT_SYNC_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET
ENRICHMENT_CACHE_DAYS=90
